{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,blue.bold,magenta.bold\" -n \"BACKEND,WEBSITE,MOBILE\" \"npm run dev:backend\" \"npm run dev:website\" \"npm run dev:mobile\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:website": "npm --prefix website run dev",
    "dev:mobile": "npm --prefix mobileapp run dev",
    "build": "npm --prefix backend run build && npm --prefix website run build && npm --prefix mobileapp run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
